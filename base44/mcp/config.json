          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "queue"
              ],
              "description": "Always pass queue"
            },
            "quote_id": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "quote_id"
          ]
        },
        "annotations": {
          "read_only_hint": false,
          "destructive_hint": false,
          "idempotent_hint": true,
          "open_world_hint": null
