{
  "name": "Auth Probe",
  "description": "One-shot temporary probe: invokes authProbe once to record the scheduled-call auth context (has_user / is_owner / is_service booleans only). Auto-archives after firing; definition and function are deleted after the result is read.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-10-06T16:37:00Z",
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auth_probe",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "probe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "authProbe",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Auth probe",
            "description": "One call; returns auth-context booleans only."
          }
        }
      }
    ]
  }
}