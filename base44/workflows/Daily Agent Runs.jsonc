{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_agent_runs",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_daily_ops": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyOperations",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run daily operations",
            "description": "All enabled section leads"
          }
        }
      }
    ]
  },
  "name": "Daily Agent Runs",
  "description": "Starts all five section-lead autonomous daily runs each morning at 07:00 MT, records results and audit trail, and escalates only true exceptions to the owner.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}