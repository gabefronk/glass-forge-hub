{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Denver",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "inbox_agents",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_gmail": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailAgent",
            "args": {
              "action": "sync",
              "mailbox_key": "gf-gmail"
            }
          },
          "then": "sync_outlook",
          "x-base44": {
            "title": "Sync Glass Forge (Gmail)",
            "description": "Every 15 minutes: pull new mail from the Glass Forge Gmail box through the shared connector, classify threads, link them to jobs, relay a job note + to-do into the Hub, label the thread in Gmail, and draft replies (never sent). One mailbox per call so each gets the full time budget; anything the budget cuts off is re-flagged and finished on the next run."
          }
        }
      },
      {
        "sync_outlook": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailAgent",
            "args": {
              "action": "sync",
              "mailbox_key": "ya-outlook"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync YA Install (Outlook)",
            "description": "Same agent on the YA Install Outlook box (inbox delta + categories). Runs after the Gmail step in its own call. Archives only when the mailbox has archive_enabled."
          }
        }
      }
    ]
  },
  "description": "Every 15 minutes, runs the inbox agents on every enabled mailbox: fetch, triage, relay to Jobs / To-dos, label, draft. Never sends mail; archiving is off unless the mailbox enables it.",
  "name": "Inbox Agents"
}