{
  "name": "JobDocumentExtraction",
  "type": "object",
  "properties": {
    "extraction_key": {
      "type": "string"
    },
    "file_id": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "source_project_id": {
      "type": "string"
    },
    "source_post_id": {
      "type": "string"
    },
    "source_attachment_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "extracted_needs_review",
        "failed"
      ]
    },
    "checked_at": {
      "type": "string"
    },
    "attempts": {
      "type": "integer"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "extractor_revision": {
      "type": "string"
    },
    "error_stage": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "error_http_status": {
      "type": "integer"
    },
    "error_redirect_origin": {
      "type": "string"
    }
  },
  "required": [
    "extraction_key",
    "file_id",
    "sha256",
    "status",
    "checked_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
