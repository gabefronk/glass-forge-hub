{
  "name": "QuoteRequests",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "settings": {
      "type": "object"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "source": {
      "type": "object"
    },
    "input_revision": {
      "type": "integer",
      "default": 1
    },
    "state_version": {
      "type": "integer",
      "default": 0
    },
    "worker_status": {
      "type": "string",
      "enum": [
        "draft",
        "queued",
        "running",
        "needs_details",
        "needs_sign_in",
        "failed",
        "ready"
      ],
      "default": "draft"
    },
    "sales_status": {
      "type": "string",
      "enum": [
        "open",
        "won"
      ],
      "default": "open"
    },
    "missing_details": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "intake_assessment": {
      "type": "object",
      "description": "Server-generated interpretation of this input revision, with understood requirements, assumptions, questions and product review items. This is not a verified quote."
    },
    "result": {
      "type": "object"
    },
    "pricing_progress": {
      "type": "object",
      "description": "Server-generated per-window progress for this reviewed package; subtotal is incomplete until every window is verified."
    },
    "checkpoint": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "job_id": {
      "type": "string",
      "default": ""
    },
    "accepted_revision": {
      "type": "integer",
      "default": 0
    },
    "accepted_snapshot": {
      "type": "object"
    },
    "accepted_at": {
      "type": "string"
    },
    "queued_at": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "lease_token": {
      "type": "string",
      "default": ""
    },
    "lease_revision": {
      "type": "integer",
      "default": 0
    },
    "lease_expires_at": {
      "type": "string"
    },
    "last_worker_event_id": {
      "type": "string"
    },
    "conversion_token": {
      "type": "string",
      "default": ""
    },
    "conversion_expires_at": {
      "type": "string"
    },
    "last_worker_lease_token": {
      "type": "string",
      "description": "Internal lease token for idempotent worker completion; never return to app users."
    },
    "execution_provider": {
      "type": "string",
      "enum": [
        "superagent",
        "legacy",
        "deterministic"
      ]
    },
    "agent_run": {
      "type": "object",
      "description": "Private Base44 operation capability, dispatch identity and recovery; never expose through public app/MCP responses."
    },
    "reviewed_restart": {
      "type": "object",
      "description": "Private server-generated authorization for an explicitly reviewed fresh attempt of a failed request. Scoped to its request, revision, attempt and archived history; never accept from ordinary input or expose in public responses.",
      "rls": { "read": false, "write": false }
    }
  },
  "required": [
    "request_id",
    "title",
    "requester_email",
    "worker_status",
    "sales_status",
    "input_revision",
    "state_version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
