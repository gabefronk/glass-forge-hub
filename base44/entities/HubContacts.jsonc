{
  "name": "HubContacts",
  "type": "object",
  "description": "Current, manually entered contacts independent of the legacy workbook snapshot; links to jobs are stored separately. A row with source \"override\" carries the owner's fixes (builder, role, merge) for the workbook contact with the same key.",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "builder": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_key": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_key": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Owner-confirmed contact role: superintendent, project_manager, builder, site, homeowner or customer. Empty uses the company label."
    },
    "status": {
      "type": "string",
      "description": "Empty or active; \"merged\" when the owner merged this contact into merged_into (kept, never deleted)."
    },
    "merged_into": {
      "type": "string",
      "description": "Key of the surviving contact after an owner merge."
    },
    "merged_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keys of contacts merged into this one."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names this person is known by (from merges)."
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional phone numbers kept from merged contacts."
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional email addresses kept from merged contacts."
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}