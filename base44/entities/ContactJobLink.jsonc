{
  "name": "ContactJobLink",
  "type": "object",
  "properties": {
    "contact_key": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Optional per-job role confirmed by the owner: superintendent, project_manager, homeowner or site. Empty uses the workbook company label."
    }
  },
  "required": [
