{
  "name": "EmailRelay",
  "type": "object",
  "description": "Inbox-agent ledger: one row per mail thread the agent looked at, holding only what it concluded and what it changed in the Hub. Never message bodies \u2014 mail stays in Gmail / Outlook; web_link opens it there.",
  "properties": {
    "mailbox_key": {
      "type": "string",
      "title": "Mailbox Key",
      "description": "EmailMailbox.key this thread belongs to"
    },
    "thread_id": {
      "type": "string",
      "title": "Thread Id",
      "description": "Provider thread id (Gmail threadId / Graph conversationId). Unique with mailbox_key."
    },
    "account_hint": {
      "type": "string",
      "title": "Account Hint",
      "description": "Address the mail was originally sent to (X-Forwarded-For / Delivered-To / To), so forwarded gabefronk@gmail.com mail stays distinguishable inside the Gmail mailbox."
    },
    "owner_only": {
      "type": "boolean",
      "title": "Owner Only",
      "default": false,
      "description": "True when the row's mailbox is owner-only (EmailMailbox.visibility === 'owner'). Denormalized at write time so RLS can restrict owner-mailbox rows to admins without joining EmailMailbox. The inbox agent sets it; never manager-readable."
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "from_name": {
      "type": "string",
      "title": "From Name",
      "description": "Sender of the latest incoming message"
    },
    "from_email": {
      "type": "string",
      "title": "From Email"
    },
    "first_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "First Message At"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Message At"
    },
    "message_count": {
      "type": "integer",
      "title": "Message Count",
      "default": 0,
      "description": "Messages the agent has seen on this thread"
    },
    "category": {
      "type": "string",
      "enum": [
        "job_update",
        "schedule",
        "quote_request",
        "order_vendor",
        "invoice_billing",
        "service_warranty",
        "builder_admin",
        "personal",
        "newsletter_promo",
        "spam",
        "other"
      ],
      "title": "Category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "normal",
        "low"
      ],
      "title": "Priority",
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "needs_reply",
        "waiting",
        "done",
        "ignored"
      ],
      "title": "Status",
      "default": "new"
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "description": "Agent's one-line summary, <= 240 chars"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Action Items",
      "default": []
    },
    "next_step": {
      "type": "string",
      "title": "Next Step"
    },
    "reply_needed": {
      "type": "boolean",
      "title": "Reply Needed",
      "default": false
    },
    "job_id": {
      "type": "string",
      "title": "Job Id",
      "description": "link to Jobs (nullable)"
    },
    "job_link_source": {
      "type": "string",
      "enum": [
        "agent_match",
        "owner"
      ],
      "title": "Job Link Source"
    },
    "job_match_confidence": {
      "type": "string",
      "enum": [
        "high",
        "low",
        "unmatched"
      ],
      "title": "Job Match Confidence"
    },
    "job_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "title": "Job Candidates",
      "default": [],
      "description": "findJobs results kept when the top match was not accepted"
    },
    "extracted": {
      "type": "object",
      "title": "Extracted",
      "additionalProperties": true,
      "description": "Facts the agent pulled from the thread: {builder, lot, address, po_numbers[], oe_numbers[], dates[], contact_name, contact_phone, contact_email, contact_role}"
    },
    "hub_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Hub Changes",
      "default": [],
      "description": "Plain-language log of what the agent changed in the Hub for this thread, e.g. \"Note added to Hutchins\", \"PO YA-0005 added\", \"To-do created\""
    },
    "applied": {
      "type": "object",
      "title": "Applied",
      "additionalProperties": true,
      "description": "Job facts the agent already applied: {po_numbers[], oe_numbers[], homeowner_contact_key}. Stops the same fact being applied twice."
    },
    "draft_id": {
      "type": "string",
      "title": "Draft Id",
      "description": "Provider draft id (Gmail draft id / Graph draft message id). The draft itself lives in the mailbox."
    },
    "draft_status": {
      "type": "string",
      "enum": [
        "none",
        "drafted",
        "discarded"
      ],
      "title": "Draft Status",
      "default": "none"
    },
    "note_id": {
      "type": "string",
      "title": "Note Id",
      "description": "JobNotes row created by the relay"
    },
    "todo_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Todo Ids",
      "default": []
    },
    "relayed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Relayed At"
    },
    "provider_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Provider Labels",
      "default": [],
      "description": "Gmail label ids / Outlook categories the agent last saw or set"
    },
    "archived": {
      "type": "boolean",
      "title": "Archived",
      "default": false
    },
    "triaged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Triaged At"
    },
    "triage_pending": {
      "type": "boolean",
      "title": "Triage Pending",
      "default": true,
      "description": "True while the thread has mail the agent has not classified yet. Cleared by the sync once triage runs."
    },
    "web_link": {
      "type": "string",
      "title": "Web Link",
      "description": "Opens the thread in the provider (Gmail #all/<threadId>; Outlook message webLink)"
    },
    "tax_record": {
      "type": "boolean",
      "title": "Tax Record",
      "default": false,
      "description": "True only when the email itself proves money moved (payment receipt, paid-invoice / PAID notice, payment confirmation, order receipt with a total charged). False for marketing, quotes, unpaid or past-due invoices, upcoming-payment notices, shipping notices and statements. Set by triage; never an instruction."
    },
    "receipt_date": {
      "type": "string",
      "format": "date",
      "title": "Receipt Date",
      "description": "YYYY-MM-DD the payment was made, only when the email states it"
    },
    "vendor": {
      "type": "string",
      "title": "Vendor",
      "description": "Who was paid, as stated by the email"
    },
    "amount_total": {
      "type": "number",
      "title": "Amount Total",
      "description": "Total charged, as stated by the email"
    },
    "reference": {
      "type": "string",
      "title": "Reference",
      "description": "Invoice or order number stated by the email"
    },
    "drive_file_id": {
      "type": "string",
      "title": "Drive File Id",
      "description": "Google Drive id of the saved receipt doc. Set once the tax-record save succeeds; a thread is never saved twice while this is present."
    },
    "drive_url": {
      "type": "string",
      "title": "Drive Url",
      "description": "Drive webViewLink of the saved receipt doc"
    },
    "tax_save_error": {
      "type": "string",
      "title": "Tax Save Error",
      "description": "Last tax-record save failure reason (e.g. 'tax save failed: drive not connected'). Cleared on success; retried on the next run while drive_file_id is empty."
    },
    "tax_save_state": {
      "type": "string",
      "enum": [
        "pending",
        "saved",
        "partial",
        "failed",
        "unknown"
      ],
      "title": "Tax Save State",
      "description": "saved = doc and every receipt attachment in Drive; partial = doc saved, an attachment pending/failed; failed = known failure, retried next run; unknown = a Drive create had an unknown outcome, later runs only look it up (read-only) until found or an admin confirms a re-create."
    },
    "tax_key": {
      "type": "string",
      "title": "Tax Key",
      "description": "Deterministic provider + mailbox + thread key written to Drive appProperties, used to find what an earlier or concurrent run already saved."
    },
    "tax_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "att_key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "saved",
              "failed",
              "unknown"
            ]
          },
          "drive_file_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "title": "Tax Attachments",
      "default": [],
      "description": "Per receipt attachment (PDF / receipt image only) save status and Drive id."
    },
    "tax_duplicate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tax Duplicate Ids",
      "default": [],
      "description": "Extra Drive files found with this thread's key (e.g. from a concurrent run). Never deleted automatically; listed for the owner to review."
    },
    "tax_lock_id": {
      "type": "string",
      "title": "Tax Lock Id",
      "description": "Best-effort lease holder for the tax save (not atomic)."
    },
    "tax_lock_until": {
      "type": "string",
      "title": "Tax Lock Until",
      "description": "ISO time the tax save lease expires."
    }
  },
  "required": [
    "mailbox_key",
    "thread_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}