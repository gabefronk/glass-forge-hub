{
  "name": "EtaCalendarLinks",
  "type": "object",
  "description": "Ties one supplier ETA (a job budget or a vendor order) to its Google Calendar events on the crew calendars picked with it (Israel's, Milan's or both). The stored Google event ids are what let a later ETA change MOVE the same events instead of creating more.",
  "properties": {
    "eta_key": {
      "type": "string",
      "title": "Eta Key",
      "description": "Stable key of the ETA this event mirrors: order:<VendorOrders id> or budget:<JobBudgets id>."
    },
    "job_id": {
      "type": "string",
      "title": "Job Id",
      "description": "Jobs record this ETA belongs to."
    },
    "google_event_id": {
      "type": "string",
      "title": "Google Event Id",
      "description": "The event id on Israel's calendar (iryedra@gmail.com), else on the one calendar it is on. Rows from before the calendar choice only have this."
    },
    "google_event_ids": {
      "type": "object",
      "title": "Google Event Ids",
      "description": "Google event id per crew calendar key: { israel, milan }."
    },
    "calendar_choice": {
      "type": "string",
      "enum": [
        "israel",
        "milan",
        "both"
      ],
      "title": "Calendar Choice",
      "description": "Crew calendar(s) the ETA event goes on, picked with the ETA. Missing means Israel's."
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date",
      "description": "The ETA day currently shown on the calendar event."
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "description": "Event title last pushed, for recognition in the Hub."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At",
      "description": "When the linked event was last created or moved."
    }
  },
  "required": [
    "eta_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}