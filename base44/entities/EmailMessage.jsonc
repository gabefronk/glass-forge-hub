{
  "name": "EmailMessage",
  "type": "object",
  "properties": {
    "mailbox_key": {
      "type": "string",
      "title": "Mailbox Key"
    },
    "thread_id": {
      "type": "string",
      "title": "Thread Id",
      "description": "Provider thread id (Gmail threadId / Graph conversationId)"
    },
    "message_id": {
      "type": "string",
      "title": "Message Id",
      "description": "Provider message id. Unique with mailbox_key."
    },
    "internet_message_id": {
      "type": "string",
      "title": "Internet Message Id",
      "description": "RFC 5322 Message-ID header"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    },
    "from_name": {
      "type": "string",
      "title": "From Name"
    },
    "from_email": {
      "type": "string",
      "title": "From Email"
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "To",
      "default": []
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Cc",
      "default": []
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "text": {
      "type": "string",
      "title": "Text",
      "description": "Plain text body with quoted replies and signatures stripped best-effort, capped at 20000 chars"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "title": "Direction",
      "default": "incoming"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "attachment_id": {
            "type": "string"
          }
        }
      },
      "title": "Attachments",
      "default": []
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Labels",
      "default": [],
      "description": "Provider label ids (Gmail) or categories (Outlook) at sync time"
    }
  },
  "required": [
    "mailbox_key",
    "thread_id",
    "message_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}