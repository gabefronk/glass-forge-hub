{
  "name": "EmailThread",
  "type": "object",
  "properties": {
    "mailbox_key": {
      "type": "string",
      "title": "Mailbox Key",
      "description": "EmailMailbox.key this thread belongs to"
    },
    "thread_id": {
      "type": "string",
      "title": "Thread Id",
      "description": "Provider thread id (Gmail threadId / Graph conversationId). Unique with mailbox_key."
    },
    "account_hint": {
      "type": "string",
      "title": "Account Hint",
      "description": "Address the mail was originally delivered to (Delivered-To / X-Forwarded-To / X-Original-To / To). Lets forwarded gabefronk@gmail.com mail stay distinguishable inside the Gmail mailbox."
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "title": "Participants",
      "default": []
    },
    "from_name": {
      "type": "string",
      "title": "From Name",
      "description": "Sender of the latest incoming message"
    },
    "from_email": {
      "type": "string",
      "title": "From Email"
    },
    "to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "To Emails",
      "default": []
    },
    "first_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "First Message At"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Message At"
    },
    "message_count": {
      "type": "integer",
      "title": "Message Count",
      "default": 0
    },
    "snippet": {
      "type": "string",
      "title": "Snippet",
      "description": "First ~200 chars of the latest message"
    },
    "has_attachments": {
      "type": "boolean",
      "title": "Has Attachments",
      "default": false
    },
    "category": {
      "type": "string",
      "enum": [
        "job_update",
        "schedule",
        "quote_request",
        "order_vendor",
        "invoice_billing",
        "service_warranty",
        "builder_admin",
        "personal",
        "newsletter_promo",
        "spam",
        "other"
      ],
      "title": "Category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "normal",
        "low"
      ],
      "title": "Priority",
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "needs_reply",
        "waiting",
        "done",
        "ignored"
      ],
      "title": "Status",
      "default": "new"
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "description": "Agent summary, <= 240 chars"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Action Items",
      "default": []
    },
    "next_step": {
      "type": "string",
      "title": "Next Step"
    },
    "reply_needed": {
      "type": "boolean",
      "title": "Reply Needed",
      "default": false
    },
    "job_id": {
      "type": "string",
      "title": "Job Id",
      "description": "link to Jobs (nullable)"
    },
    "job_link_source": {
      "type": "string",
      "enum": [
        "agent_match",
        "owner"
      ],
      "title": "Job Link Source"
    },
    "job_match_confidence": {
      "type": "string",
      "enum": [
        "high",
        "low",
        "unmatched"
      ],
      "title": "Job Match Confidence"
    },
    "job_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "title": "Job Candidates",
      "default": [],
      "description": "findJobs results kept when the top match was not accepted"
    },
    "extracted": {
      "type": "object",
      "title": "Extracted",
      "additionalProperties": true,
      "description": "Facts the agent pulled from the thread: {builder, lot, address, po_numbers[], oe_numbers[], dates[], contact_name, contact_phone}"
    },
    "draft_id": {
      "type": "string",
      "title": "Draft Id",
      "description": "Provider draft id (Gmail draft id / Graph draft message id)"
    },
    "draft_preview": {
      "type": "string",
      "title": "Draft Preview",
      "description": "Plain text of the drafted reply"
    },
    "draft_status": {
      "type": "string",
      "enum": [
        "none",
        "drafted",
        "sent",
        "discarded"
      ],
      "title": "Draft Status",
      "default": "none"
    },
    "note_id": {
      "type": "string",
      "title": "Note Id",
      "description": "JobNotes row created by the relay"
    },
    "todo_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Todo Ids",
      "default": []
    },
    "relayed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Relayed At"
    },
    "provider_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Provider Labels",
      "default": []
    },
    "archived": {
      "type": "boolean",
      "title": "Archived",
      "default": false
    },
    "triaged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Triaged At"
    },
    "triage_pending": {
      "type": "boolean",
      "title": "Triage Pending",
      "default": true,
      "description": "True while the thread has messages the agent has not classified yet (new thread, or new incoming mail). Cleared by the sync once triage runs."
    },
    "web_link": {
      "type": "string",
      "title": "Web Link",
      "description": "Deep link to open the thread in the provider (Gmail #all/<threadId>; Outlook message webLink)"
    }
  },
  "required": [
    "mailbox_key",
    "thread_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}