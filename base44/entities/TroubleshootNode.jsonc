{
  "name": "TroubleshootNode",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "title": "Node Id",
      "description": "Stable key identifying this node in the tree."
    },
    "type": {
      "type": "string",
      "enum": [
        "question",
        "steps",
        "info",
        "resolved",
        "call"
      ],
      "title": "Type",
      "description": "question = options branch; steps = numbered procedure + follow-up; info = informational branch; resolved = session end + log; call = call Summit script."
    },
    "text": {
      "type": "string",
      "title": "Text",
      "description": "Question text (question) or body text (info)."
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Heading for steps / info nodes."
    },
    "source": {
      "type": "string",
      "title": "Source",
      "description": "Provenance tag (factory: SA-xxxx, field_verified, unconfirmed)."
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Numbered procedure steps (steps nodes)."
    },
    "question": {
      "type": "string",
      "title": "Question",
      "description": "Follow-up question after a steps procedure."
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "next": {
            "type": "string",
            "description": "Target node_id."
          }
        }
      },
      "default": [],
      "description": "Branch options for question / steps / info nodes."
    },
    "resolution": {
      "type": "string",
      "title": "Resolution",
      "description": "Resolved-node outcome label (e.g. 'Soft reset')."
    },
    "log_prompt": {
      "type": "string",
      "title": "Log Prompt",
      "description": "What to log at a resolved node."
    },
    "script": {
      "type": "string",
      "title": "Call Script",
      "description": "What to read to Summit tech support at a call node."
    },
    "version": {
      "type": "string",
      "default": "v1.1"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "node_id",
    "type"
  ]
}