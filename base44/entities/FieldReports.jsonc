{
  "name": "FieldReports",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job Id",
      "description": "Stable Jobs record link (nullable)"
    },
    "job_link_source": {
      "type": "string",
      "enum": [
        "probuild_project",
        "po_oe",
        "name_exact",
        "owner",
        "ingest_match"
      ]
    },
    "job_linked_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_date": {
      "type": "string",
      "format": "date",
      "title": "Job Date",
      "description": "Denver-converted date of the Probuild post (UTC \u2192 America/Denver at ingest)"
    },
    "job_name": {
      "type": "string",
      "title": "Job Name",
      "description": "Probuild project name"
    },
    "message": {
      "type": "string",
      "title": "Message",
      "description": "Verbatim post message / notes"
    },
    "original_text": {
      "type": "string",
      "title": "Original Text",
      "description": "Snapshot of the original Probuild message the first time the report text is edited from the Hub. Set once and never overwritten, so the source wording survives later edits and re-syncs."
    },
    "edited_at": {
      "type": "string",
      "format": "date-time",
      "title": "Edited At",
      "description": "When the report text was last edited from the Hub."
    },
    "edited_by": {
      "type": "string",
      "title": "Edited By",
      "description": "Email of the user who last edited the report text from the Hub."
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Photo Urls",
      "default": [],
      "description": "Attachment URLs from the Probuild post"
    },
    "attachment_count": {
      "type": "number",
      "title": "Attachment Count",
      "default": 0,
      "description": "Number of attachments on the Probuild post. Probuild stores attachments as a keyed object (attachment id \u2192 record), so this is computed with countAttachments() which handles both array and object shapes."
    },
    "post_id": {
      "type": "string",
      "title": "Post Id",
      "description": "Probuild post ID (unique upsert key)"
    },
    "project_id": {
      "type": "string",
      "title": "Project Id",
      "description": "Probuild project ID"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "Original UTC creation timestamp of the Probuild post"
    },
    "man_hours": {
      "type": "number",
      "title": "Man Hours",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        },
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      }
    },
    "trip_charges": {
      "type": "number",
      "title": "Trip Charges",
      "rls": {
        "read": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        },
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "manager"
              }
            }
          ]
        }
      }
    },
    "source_message_baseline": {
      "type": "string",
      "title": "Source Message Baseline",
      "description": "Verbatim source post message captured at the last sync that wrote the Hub message. The source-note follow-through update gate requires the current Hub message to byte-equal this baseline before any source-driven update. Null on legacy rows that predate the field; empty string on new rows whose source had no text yet."
    },
    "source_baseline_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source Baseline At",
      "description": "When source_message_baseline was last set (the sync time that produced the current baseline)."
    }
  },
  "required": [
    "job_date",
    "job_name",
    "post_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}