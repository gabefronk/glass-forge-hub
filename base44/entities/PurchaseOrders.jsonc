{
  "name": "PurchaseOrders",
  "type": "object",
  "properties": {
    "budget_id": {
      "type": "string",
      "description": "Explicit source budget; job_id must match."
    },
    "budget_snapshot": {
      "type": "object",
      "description": "Source budget as reviewed at issuance; not overwritten by later edits."
    },
    "request_key": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "additional_order_reason": {
      "type": "string"
    },
    "po_number": {
      "type": "string",
      "title": "PO number, e.g. YA-0001",
      "description": "YA Windows and Doors sequence. Assigned by issue_purchase_order (max existing + 1, zero-padded to 4); never reused or renumbered."
    },
    "job_id": {
      "type": "string",
      "description": "Linked Jobs record. The PO number is appended to that job's po_numbers."
    },
    "job_name": {
      "type": "string"
    },
    "builder": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "vendor": {
      "type": "string",
      "description": "Supplier the order is placed with, e.g. AMSCO."
    },
    "vendor_quote_ref": {
      "type": "string",
      "description": "Vendor quote number the PO orders against, e.g. Amsco 3517590."
    },
    "amount_dealer": {
      "type": "number",
      "description": "Dealer cost (what Glass Forge pays the vendor)."
    },
    "amount_customer": {
      "type": "number",
      "description": "Customer sell price for the same scope."
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "emailed",
        "ordered",
        "confirmed",
        "received",
        "cancelled"
      ],
      "default": "issued",
      "description": "issued = number assigned; emailed = order sent to vendor; ordered/confirmed = vendor accepted; received = material in hand."
    },
    "order_email_ref": {
      "type": "string",
      "description": "Reference to the order email sent to the vendor (Gmail message/thread id or subject). The Hub's order email stores the Outlook message link."
    },
    "order_email_status": {
      "type": "string",
      "enum": [
        "sent",
        "drafted"
      ],
      "description": "Hub order email (orderEmail function, Oct 30 2026): sent from Outlook, or saved as an Outlook draft."
    },
    "order_email_at": {
      "type": "string",
      "description": "When the Hub order email was sent or drafted (ISO time)."
    },
    "order_email_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who the Hub order email went to; the next order to the same supplier starts from this list."
    },
    "order_email_subject": {
      "type": "string"
    },
    "order_email_body": {
      "type": "string",
      "description": "The order email text as sent (plain text)."
    },
    "order_email_mailbox": {
      "type": "string",
      "description": "The Outlook mailbox the order email came from."
    },
    "order_email_request_key": {
      "type": "string",
      "description": "Request key of the last order email click, so a retry never sends twice."
    },
    "notes": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    },
    "setup_sheet_id": {
      "type": "string",
      "description": "Optional JobSetupSheets record marked approved in Hub, used only as job context; entered approver fields do not authenticate the named person."
    },
    "setup_sheet_approver_name": {
      "type": "string",
      "description": "Entered approver-name snapshot from JobSetupSheets, not verified approval."
    },
    "setup_sheet_approved_date": {
      "type": "string",
      "description": "Entered approved-date snapshot from JobSetupSheets, not verified approval."
    },
    "owner_reviewed_at": {
      "type": "string",
      "description": "Timestamp of the owner's explicit PO review and submit."
    },
    "purchase_type": {
      "type": "string",
      "enum": [
        "job",
        "shop"
      ],
      "description": "Explicit shop purchases need no job and must not be treated as unlinked job costs."
    }
  },
  "required": [
    "po_number",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}