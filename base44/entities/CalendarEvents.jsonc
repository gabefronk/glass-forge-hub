{
  "name": "CalendarEvents",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job Id",
      "description": "link to Jobs (nullable)"
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "google"
      ],
      "title": "Source",
      "description": "app = authored in this app and pushed out; google = read-only event from Google Calendar"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time",
      "description": "HH:MM 24h, nullable = all-day"
    },
    "end_time": {
      "type": "string",
      "title": "End Time",
      "description": "HH:MM 24h, nullable = all-day. Copied from source event end.dateTime."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date",
      "description": "Exclusive end date for all-day events (Google convention). Null for timed events."
    },
    "job_name": {
      "type": "string",
      "title": "Job Name"
    },
    "builder": {
      "type": "string",
      "title": "Builder"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "source_location": {
      "type": "string",
      "title": "Source Location",
      "description": "Raw Google Calendar event location, copied to installer event after sanitizing."
    },
    "scope_notes": {
      "type": "string",
      "title": "Scope Notes",
      "description": "Crew-safe details only"
    },
    "labor_amt": {
      "type": "number",
      "title": "Labor Amt",
      "description": "Labor dollar amount \u2014 parsed from scope notes for Google events, manually set for app events"
    },
    "crew": {
      "type": "string",
      "title": "Crew"
    },
    "prerequisites": {
      "type": "string",
      "title": "Prerequisites",
      "description": "forklift, lift, access, materials"
    },
    "google_event_id": {
      "type": "string",
      "title": "Google Event Id",
      "description": "full calendar event id"
    },
    "installer_event_id": {
      "type": "string",
      "title": "Installer Event Id",
      "description": "sanitized installer calendar event id"
    },
    "sanitize_flagged": {
      "type": "boolean",
      "title": "Sanitize Flagged",
      "default": false,
      "description": "true if a $ survived sanitizing and the installer description was dropped entirely"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    },
    "organizer": {
      "type": "string",
      "title": "Organizer",
      "description": "Email of the Google Calendar event organizer (populated for google-sourced events)"
    },
    "po_number": {
      "type": "string",
      "title": "PO Number",
      "description": "BFS purchase order number extracted from the event description"
    },
    "oe_number": {
      "type": "string",
      "title": "OE Number",
      "description": "Order element number extracted from the event description"
    },
    "report_required": {
      "type": "boolean",
      "title": "Report Required",
      "default": true,
      "description": "Whether this event requires a Probuild field report. Default true; can be turned off for specific event types later."
    },
    "report_status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "missing_photos",
        "missing_notes",
        "missing_all",
        "rescheduled",
        "waived"
      ],
      "title": "Report Status",
      "default": "pending",
      "description": "Current field-report audit status for this event"
    },
    "report_due_at": {
      "type": "string",
      "format": "date-time",
      "title": "Report Due At",
      "description": "End of the event's day in America/Denver (UTC ISO). The report is due by this time."
    },
    "report_checked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Report Checked At",
      "description": "Last audit run timestamp against this event"
    },
    "days_late": {
      "type": "number",
      "title": "Days Late",
      "default": 0,
      "description": "Whole days past report_due_at while report_status is not ok"
    },
    "original_scheduled_date": {
      "type": "string",
      "format": "date",
      "title": "Original Scheduled Date",
      "description": "Set the first time an event's date changes, so we keep the date it was originally supposed to be done"
    },
    "reschedule_count": {
      "type": "number",
      "title": "Reschedule Count",
      "default": 0
    },
    "matched_post_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Matched Post Ids",
      "default": [],
      "description": "Probuild post IDs matched to this event by the audit"
    },
    "match_method": {
      "type": "string",
      "enum": [
        "address",
        "name_date",
        "manual",
        "none"
      ],
      "title": "Match Method",
      "description": "How the field report was matched to this event"
    },
    "match_confidence": {
      "type": "number",
      "title": "Match Confidence",
      "description": "0\u20131 confidence score from the matcher"
    },
    "waived_by": {
      "type": "string",
      "title": "Waived By",
      "description": "Email of the admin who waived the report requirement"
    },
    "waived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Waived At"
    },
    "waive_reason": {
      "type": "string",
      "title": "Waive Reason"
    }
  },
  "required": [
    "source",
    "event_date",
    "job_name",
    "labor_amt",
    "google_event_id",
    "created_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}