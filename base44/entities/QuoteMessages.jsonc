{
  "name": "QuoteMessages",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "client_message_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "default": 0
    },
    "message_at": {
      "type": "string"
    },
    "author": {
      "type": "string"
    }
  },
  "required": [
    "quote_id",
    "role",
    "content",
    "client_message_id",
    "revision"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}