{
  "name": "QuoteMessages",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "client_message_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "default": 0
    },
    "message_at": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "initial_request",
        "user_message",
        "clarification",
        "clarification_reply",
        "progress",
        "ready"
      ],
      "description": "Semantic display category. Optional for legacy messages; raw content remains in the audit."
    },
    "worker_status": {
      "type": "string",
      "enum": [
        "running",
        "needs_details",
        "needs_sign_in",
        "failed",
        "ready"
      ],
      "description": "Worker status when the message was recorded, used to distinguish questions from progress."
    }
  },
  "required": [
    "quote_id",
    "role",
    "content",
    "client_message_id",
    "revision"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}