{
  "name": "JobBudgets",
  "properties": {
    "deleted_at": {
      "type": "string",
      "description": "Unused quote removed from active lists; source record and files retained for recovery."
    },
    "deleted_by": {
      "type": "string"
    },
    "deletion_reason": {
      "type": "string"
    },
    "deletion_request_key": {
      "type": "string"
    },
    "budget_usage": {
      "type": "string",
      "enum": [
        "draft",
        "included",
        "reference"
      ],
      "description": "Optional scope selection. Absent means legacy inclusion. Existing records are not migrated."
    },
    "replaces_budget_id": {
      "type": "string"
    },
    "numbers_reviewed_at": {
      "type": "string"
    },
    "numbers_reviewed_by": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "request_key": {
      "type": "string"
    },
    "input_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "link_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "autofill": {
      "description": "What the drop filled from the quote and the install price sheet: sources per field, notes for what still needs typing, labor lines priced, install material.",
      "type": "object"
    },
    "builder": {
      "type": "string"
    },
    "computed": {
      "description": "jobBudgetMath output: cost basis, target sells, margin %.",
      "type": "object"
    },
    "created_by_email": {
      "type": "string"
    },
    "drive_budget_csv_file_id": {
      "type": "string"
    },
    "drive_budget_xlsx_file_id": {
      "type": "string"
    },
    "drive_job_folder_id": {
      "type": "string"
    },
    "drive_job_folder_path": {
      "description": "Glass Forge Jobs/<Builder>/<Job>",
      "type": "string"
    },
    "drive_quote_file_id": {
      "type": "string"
    },
    "glass_eta_date": {
      "description": "ETA for the glass from the supplier (Steve), ISO date.",
      "type": "string"
    },
    "glass_eta_source": {
      "description": "Where the ETA came from (Steve text/email, manual).",
      "type": "string"
    },
    "glass_eta_status": {
      "default": "none",
      "enum": [
        "none",
        "waiting",
        "eta_set",
        "ready",
        "picked_up"
      ],
      "type": "string"
    },
    "inputs": {
      "description": "Workbook inputs: material_true_cost, labor fields, extras, actual_total_sell.",
      "type": "object"
    },
    "job_id": {
      "description": "Linked Jobs record when the match is confident.",
      "type": "string"
    },
    "job_match": {
      "description": "Match evidence: tokens, candidate job ids, why review is needed.",
      "type": "object"
    },
    "job_name": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "openings_qty": {
      "type": "integer"
    },
    "quote": {
      "description": "Normalized vendor quote extraction (parse source, bill/ship to, totals).",
      "type": "object"
    },
    "quote_name": {
      "type": "string"
    },
    "quote_number": {
      "type": "string"
    },
    "quoted_by": {
      "type": "string"
    },
    "source_pdf_name": {
      "type": "string"
    },
    "source_pdf_url": {
      "description": "Base44 storage URL of the dropped quote PDF.",
      "type": "string"
    },
    "source_pdf_uri": {
      "description": "Private Base44 storage URI of the dropped quote PDF (UploadPrivateFile). Never a public URL. Server re-signs a short-lived fetch URL only when the reader or owner needs it; this ref is the stable saved source.",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "description": "filed = budget sheet + quote PDF are in the Drive job folder; needs_review = job match or extraction uncertain.",
      "enum": [
        "draft",
        "filed",
        "needs_review"
      ],
      "type": "string"
    },
    "title": {
      "title": "Budget title, e.g. BAXTER - GLASS (Amsco 3517590)",
      "type": "string"
    },
    "vendor": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}