{
  "name": "SalesTrackerSnapshot",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_path": {
      "type": "string"
    },
    "sheet_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "row_count": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "validated"
      ]
    },
    "file_uri": {
      "type": "string"
    }
  },
  "required": [
    "filename",
    "sha256",
    "imported_at",
    "source_captured_at",
    "row_count",
    "status",
    "file_uri"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}