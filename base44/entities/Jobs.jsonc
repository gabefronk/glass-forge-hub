{
  "name": "Jobs",
  "type": "object",
  "properties": {
    "canonical_name": {
      "type": "string",
      "title": "Canonical Name"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "default": []
    },
    "po_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "PO Numbers",
      "default": [],
      "description": "BFS purchase order numbers linked to this job (many-to-one: reorders get their own PO)"
    },
    "oe_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "OE Numbers",
      "default": [],
      "description": "Order element numbers linked to this job (many-to-one)"
    },
    "address": {
      "type": "string",
      "title": "Address",
      "description": "Job site address \u2014 a hard match key that doesn't change when the name is written differently"
    },
    "address_manual": {
      "type": "boolean",
      "title": "Address Set by Manager",
      "default": false,
      "description": "True when a manager edited the jobsite address in the Hub (including an intentional clear). Calendar ingest never fills or replaces a manager-touched address."
    },
    "builder": {
      "type": "string",
      "title": "Builder",
      "description": "Builder / GC name extracted from the job name (part before the dash)"
    },
    "drive_job_folder_id": {
      "type": "string",
      "description": "Verified Google Drive folder for this job; signed-in linking UI.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "drive_job_folder_url": {
      "type": "string",
      "description": "Verified Drive folder link, not a guessed URL.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "source_window_quote_id": {
      "type": "string",
      "description": "Source Window Quotes request; stable link and conversion reconciliation key."
    },
    "accepted_quote_revision": {
      "type": "integer",
      "description": "Accepted quote input revision.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "accepted_quote_snapshot": {
      "type": "object",
      "description": "Immutable accepted window schedule, pricing and AMSCO reference; admin-only finance data.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "customer_name": {
      "type": "string",
      "description": "Customer supplied when a window sale is won."
    },
    "stage": {
      "type": "string",
      "enum": [
        "quoted",
        "sold",
        "ordered",
        "handed_off",
        "scheduled",
        "installed",
        "closed"
      ],
      "description": "Where the job is in its life: quoted \u2192 sold \u2192 ordered \u2192 handed_off (Stage 2, in the PM's hands) \u2192 scheduled \u2192 installed \u2192 closed. Set by hand from the job hero; the handoff sets handed_off itself."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "sent_to_customer",
        "ordered",
        "half_down",
        "delivered",
        "installed",
        "billed",
        "waiting_on_check",
        "waiting_on_payment",
        "paid",
        "sent_for_payment",
        "partial"
      ],
      "description": "Job stage (shown as Job stage; the field keeps its old name): sent to customer, ordered, half down paid, delivered, installed, billed, waiting on check, waiting on payment, paid. sent_for_payment and partial are retired but kept so older jobs still read correctly. Null means no stage set yet. Set from the Purchasing row and the job page."
    },
    "payment_status_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment_status was last changed (ISO timestamp)."
    },
    "pm_member_key": {
      "type": "string",
      "description": "TeamMember.member_key of who runs the job after handoff (e.g. Milan)."
    },
    "handoff_id": {
      "type": "string",
      "description": "JobHandoffs row for this job, once one exists."
    },
    "is_sample": {
      "type": "boolean",
      "title": "Is Sample",
      "default": false,
      "description": "True for demo/test jobs excluded from all matching, lists and totals."
    },
    "merged_into": {
      "type": "string",
      "title": "Merged Into",
      "description": "ID of the Jobs record this duplicate was merged into. Set by the merge tool; hidden from all lists and matching once set."
    },
    "merged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Merged At",
      "description": "When this job was merged into another (for audit and reversal)."
    },
    "new_sale_run_id": {
      "type": "string",
      "description": "Owner-reviewed new-sale journal identity; no historical backfill.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "id": "6a7f0d834a5f825c724273ea"
              }
            },
            {
              "user_condition": {
                "id": "6a8229a9801b2aef9278ff47"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "canonical_name"
  ]
}