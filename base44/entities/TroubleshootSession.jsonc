{
  "name": "TroubleshootSession",
  "type": "object",
  "properties": {
    "system_type": {
      "type": "string",
      "title": "System Type",
      "description": "Door/system type selected at the start of the walkthrough (e.g. Multi-slide, Pivot)."
    },
    "motor": {
      "type": "string",
      "title": "Motor",
      "description": "Motor model selected at the start of the walkthrough (Peak, Sierra, Everest, Tahoe, or Not sure)."
    },
    "control_type": {
      "type": "string",
      "title": "Control Type",
      "description": "Wall control selected at the start of the walkthrough (3-in-1, 6-in-1, 9-in-1, 12-in-1, RF fob, or Not sure)."
    },
    "symptom": {
      "type": "string",
      "title": "Symptom",
      "description": "Top-level symptom selected from the entry picker."
    },
    "node_path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered list of node_ids visited during the walkthrough."
    },
    "resolution": {
      "type": "string",
      "enum": [
        "resolved",
        "escalated",
        "abandoned",
        ""
      ],
      "default": "",
      "title": "Resolution"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Optional tech notes from the walkthrough."
    },
    "tech_support_answer": {
      "type": "string",
      "title": "Tech Support Answer",
      "description": "Verbatim answer from Summit tech support, if called."
    }
  },
  "required": [
    "node_path"
  ]
}