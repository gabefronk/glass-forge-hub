{
  "name": "Invoices",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number",
      "description": "QuickBooks invoice number, Glass Forge GF-YYYY-NNN, or a YA customer invoice printed from Budget & Orders (YA-YYMMDD-NN, the date plus that day's next number). Unique per invoice."
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "title": "Invoice Date",
      "description": "Date on the invoice."
    },
    "kind": {
      "type": "string",
      "enum": [
        "labor_billing",
        "deposit",
        "balance",
        "progress",
        "other",
        "glass_forge"
      ],
      "title": "Kind",
      "description": "labor_billing: monthly install/service labor lines billed to BFS (lines are FeeLines carrying this invoice_id). deposit/balance/progress/other: a customer invoice on one job. glass_forge: Glass Forge LLC's monthly consulting invoice to YA Windows and Doors (10% of install labor plus its share of outside sales), recorded from the issued document."
    },
    "customer_name": {
      "type": "string",
      "title": "Customer",
      "description": "Who the invoice is addressed to (e.g. BFS, a builder, a homeowner, YA Windows and Doors)."
    },
    "job_id": {
      "type": "string",
      "title": "Job",
      "description": "The job a customer invoice belongs to. Empty for labor billing and Glass Forge invoices, which span jobs."
    },
    "budget_id": {
      "type": "string",
      "title": "Budget",
      "description": "Optional budget (scope) a customer invoice bills against."
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "description": "Invoice total. For labor billing, the labor total of its lines when recorded. For a Glass Forge invoice, the amount due."
    },
    "fee_amount": {
      "type": "number",
      "title": "Fee Amount",
      "description": "Labor billing only: the fee total of its lines when recorded."
    },
    "line_count": {
      "type": "number",
      "title": "Line Count",
      "description": "Labor billing: number of FeeLines on the invoice when recorded. Glass Forge: number of job lines on the issued invoice."
    },
    "service_month": {
      "type": "string",
      "title": "Service Month",
      "description": "Glass Forge invoices: the month of work billed, YYYY-MM."
    },
    "job_value": {
      "type": "number",
      "title": "Job Value",
      "description": "Glass Forge invoices: the invoice's total YA job value (install labor plus product sale values)."
    },
    "split_amount": {
      "type": "number",
      "title": "Split Amount",
      "description": "Glass Forge invoices: the part of the amount due from product / profit-split lines (50% or varied rate), the rest being the 10% install fee."
    },
    "source_url": {
      "type": "string",
      "title": "Source Document",
      "description": "Link to the issued invoice document (e.g. Google Drive)."
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date",
      "description": "Date payment was received. Empty while the invoice is open."
    },
    "payment_reference": {
      "type": "string",
      "title": "Payment Reference",
      "description": "Optional check, ACH or QuickBooks payment reference."
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time",
      "title": "Voided At",
      "description": "Set when the invoice is voided; its lines are reopened. Voided invoices stay for history."
    },
    "created_by_email": {
      "type": "string",
      "title": "Created By"
    },
    "document": {
      "type": "object",
      "title": "Printed document",
      "description": "YA customer invoices printed from Budget & Orders: the exact invoice (type, number, bill to, project, lines, options, company and payment details, attachments) so a reprint is the same document."
    }
  },
  "required": [
    "invoice_number",
    "invoice_date",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
