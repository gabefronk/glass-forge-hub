{
  "name": "ProbuildAuth",
  "type": "object",
  "properties": {
    "refresh_token": {
      "type": "string",
      "title": "Refresh Token",
      "description": "Current Probuild Firebase refresh token (rotated on each exchange)"
    },
    "last_exchanged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Exchanged At"
    }
  },
  "required": [
    "refresh_token"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}